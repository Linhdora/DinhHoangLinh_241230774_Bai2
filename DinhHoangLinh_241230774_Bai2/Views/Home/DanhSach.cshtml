@model IEnumerable<DinhHoangLinh_241230774_Bai2.Models.TaiSan>
<div class="section-head">
                <h3>@(ViewBag.TenLoai??ViewBag.TieuDe)</h3>
                <a href="#">Xem tất cả &rsaquo;</a>
            </div>
        <div class="grid">
    @foreach(var x in Model)
    {
        <div class="asset-card">
                    <a href="#"><img src="images/@x.Anh" alt="" /></a>
                    <h2>@x.TenTs</h2>
                    <div class="asset-foot"><span class="price">@x.NguyenGia</span>
                        <button class="btn-buy">Chi tiết</button>
<a asp-controller="Home" asp-action="Edit" asp-route-id="@x.MaTs">Sua</a>
                        </div>
                </div>
    }
        </div>